# Copy to .env.local and edit.

# Where your ComfyUI server lives. Local default shown; for cloud GPUs use the
# public/tunnel URL, e.g. https://abc123-8188.proxy.runpod.net
COMFY_URL=http://127.0.0.1:8188

# Optional: one extra header sent on every ComfyUI request (HTTP + WebSocket),
# for instances behind an auth proxy. Format "Header-Name: value".
# COMFY_AUTH_HEADER=Authorization: Bearer your-token

# VRAM class of the ComfyUI host: "low" (8-12 GB, default) or "high" (24 GB+ cloud GPUs).
# high = full-batch VAE decode, denser AnimateDiff overlap, up to 128 frames, SDXL video allowed.
# COMFY_VRAM_PROFILE=low

# Optional: protect the dashboard itself with HTTP Basic Auth.
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=change-me

# Character LoRAs: local folders (relative to this repo). Defaults shown.
# OBSCURA_DATA_DIR=../characters                        # datasets + training runs
# COMFY_DIR=../ComfyUI_windows_portable/ComfyUI          # LoRAs are written to <COMFY_DIR>/models/loras/obscura
# TRAINER_DIR=../trainer                                 # kohya sd-scripts checkout + its venv
