# Copy to .env.local and edit. setup_cloud.sh writes this file for you on the GPU box.

# Where ComfyUI listens. On the GPU box it's private on localhost; for local development
# against a cloud pod use its tunnel URL, e.g. https://abc123-8188.proxy.runpod.net
COMFY_URL=http://127.0.0.1:8188

# Optional: one extra header sent on every ComfyUI request (HTTP + WebSocket),
# for instances behind an auth proxy. Format "Header-Name: value".
# COMFY_AUTH_HEADER=Authorization: Bearer your-token

# Protect the dashboard with HTTP Basic Auth. Keep this set whenever the port is reachable.
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=change-me

# Checkpoint the studio starts on (must be installed). Unset = Pony V6 XL if present, else the first SDXL file.
# OBSCURA_DEFAULT_CHECKPOINT=RealVisXL_V5.0_fp16.safetensors

# Folders shared with ComfyUI and kohya on the same box (relative to this repo). Defaults shown,
# matching the /workspace layout setup_cloud.sh creates.
# OBSCURA_DATA_DIR=../characters    # datasets, captions, training runs
# COMFY_DIR=../ComfyUI              # LoRAs are written to <COMFY_DIR>/models/loras/obscura
# TRAINER_DIR=../trainer            # kohya sd-scripts checkout + its venv
